# Copy to /var/www/html/ainews/.env  (chown apache:apache, chmod 640)
LISTEN_PORT=8006
AINEWS_DB_HOST=127.0.0.1
AINEWS_DB_PORT=3306
AINEWS_DB_USER=ainews
AINEWS_DB_PASSWORD=replace-me
AINEWS_DB_NAME=ainews
AINEWS_MAX_FEED_ITEMS=30
AINEWS_USER_AGENT="AINewsHQ/0.1 (+https://ainews.redmesastudios.com; feed reader)"
