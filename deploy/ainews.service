[Unit]
Description=AI News HQ FastAPI service (uvicorn)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=apache
Group=apache
WorkingDirectory=/var/www/html/ainews
EnvironmentFile=/var/www/html/ainews/.env
ExecStart=/var/www/html/ainews/.venv/bin/uvicorn ainews.app:app --host 127.0.0.1 --port ${LISTEN_PORT} --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
